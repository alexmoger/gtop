;;;     PROD MDP        ;;;
;;; https://manual.gromacs.org/current/user-guide/mdp-options.html
;;; https://cgmartini.nl/docs/downloads/example-input-files/md-parameters.html


;;; 10 us
;;; 10 000 frame compressed trajectory
 

;;; integration stuff ;;;
integrator               = md
dt                       = 0.02         ; 20 fs timestep
nsteps                   = 500000000    ; 500 000 000 steps, 10us trajectory
;;;


;;; trajectory stuff ;;; 
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 25000        ; 500ps .log output 
nstenergy                = 25000        ; 500ps .edr output
nstxout-compressed       = 50000        ; 1ns compression - martini3 mdp uses 1 ns - dont need higher since using pylipid and need taht level of compression for anaylsis
compressed-x-precision   = 100
compressed-x-grps        =
energygrps               = System
;;;                   


;;; ff specific stuff (NOTOUCH) ;;;
cutoff-scheme            = Verlet
nstlist                  = 20
nsttcouple               = 20
nstpcouple               = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1
ns_type                  = grid
pbc                      = xyz
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15	; 2.5 (with polarizable water)
epsilon_rf               = 0
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
;;;


;;; temperature coupling ;;;
tcoupl                   = v-rescale
tc-grps                  = SOLV SOLUT MEMB          ; SOLV=water+ions, SOLUT=protein, MEMB=lipids
tau_t                    = 1.0 1.0 1.0              ; 1ps relaxation time
ref_t                    = 310.15 310.15 310.15     ; T=310.15K
gen_vel                  = no
gen_temp                 = 310.15
gen_seed                 = -1
;;;


;;; pressure coupling ;;;
Pcoupl                   = c-rescale   
Pcoupltype               = semiisotropic            ; semiiso coupling with membranes
tau_p                    = 4.0                      ; 4ps relaxation time, don't touch with lipids
ref_p                    = 1.0 1.0                  ; P=1bar
compressibility          = 3e-4 3e-4 


;;; constraint stuff ;;;
constraints              = none                     ; no hbond constraints since no hbonds
constraint_algorithm     = Lincs                    ; LINCS constraint algorithm
lincs_order              = 8
lincs_warnangle          = 90
lincs_iter               = 2
;;;


;;; refcoord-scaling for positional restraints ;;;
refcoord_scaling         = all                      ; relevant only when using posres, probably dont touch


;;; com stuff ;;;
comm-mode                = Linear
nstcomm                  = 100
comm-grps                = SOLV SOLUT_MEMB          ; comm handled conventionally, memb/protien and solv separate



